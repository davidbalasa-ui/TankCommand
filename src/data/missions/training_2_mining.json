  "triggers": [
    {
      "id": "intro",
      "when": {
        "t": "time",
        "tick": 0
      },
      "do": [
        {
          "t": "message",
          "speaker": "Command",
          "text": "Your Prospector and Hauler are beside the pad. Ore fields are the pink rocks."
        }
      ]
    },
    {
      "id": "dig",
      "when": {
        "t": "resourceReached",
        "side": 1,
        "ore": 10
      },
      "do": [
        {
          "t": "setObjective",
          "id": "dig",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "crew",
          "status": "add",
          "text": "Buy a second Prospector and a second Hauler. Send the new Prospector to dig too",
          "kind": "primary"
        },
        {
          "t": "message",
          "speaker": "Command",
          "text": "First load home! Haulers fetch the crates by themselves. Here is 150 ore to grow."
        },
        {
          "t": "grant",
          "side": 1,
          "ore": 150
        }
      ]
    },
    {
      "id": "crew",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "objectiveDone",
            "id": "dig"
          },
          {
            "t": "and",
            "conds": [
              {
                "t": "unitsAlive",
                "side": 1,
                "unitType": "unit.human.ore_miner",
                "op": ">=",
                "count": 2
              },
              {
                "t": "unitsAlive",
                "side": 1,
                "unitType": "unit.human.tug",
                "op": ">=",
                "count": 2
              }
            ]
          }
        ]
      },
      "do": [
        {
          "t": "setObjective",
          "id": "crew",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "bank",
          "status": "add",
          "text": "Bank 400 ore. The ore count is at the top of the screen",
          "kind": "primary"
        },
        {
          "t": "message",
          "speaker": "Command",
          "text": "Two crews dig twice as fast. Keep an idle miner busy: tap it, then an ore field."
        }
      ]
    },
    {
      "id": "bank",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "objectiveDone",
            "id": "crew"
          },
          {
            "t": "resourceReached",
            "side": 1,
            "ore": 400
          }
        ]
      },
      "do": [
        {
          "t": "setObjective",
          "id": "bank",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "spend",
          "status": "add",
          "text": "Ore buys everything. Spend some: buy a Lancer",
          "kind": "primary"
        },
        {
          "t": "message",
          "speaker": "Command",
          "text": "400 ore banked. Tanks, buildings and workers are all paid in ore."
        }
      ]
    },
    {
      "id": "spend",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "objectiveDone",
            "id": "bank"
          },
          {
            "t": "unitsAlive",
            "side": 1,
            "unitType": "unit.human.light_tank",
            "op": ">=",
            "count": 1
          }
        ]
      },
      "do": [
        {
          "t": "setObjective",
