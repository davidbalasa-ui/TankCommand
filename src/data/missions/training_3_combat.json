      "id": "move",
      "when": {
        "t": "areaEntered",
        "side": 1,
        "x": -14,
        "z": 18,
        "radius": 6
      },
      "do": [
        {
          "t": "setObjective",
          "id": "move",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "all",
          "status": "add",
          "text": "Double-tap a Lancer to pick every Lancer on screen, or tap All army. Move them to the ring",
          "kind": "primary"
        },
        {
          "t": "message",
          "speaker": "Command",
          "text": "Well done. Drag one finger on the map to look around."
        }
      ]
    },
    {
      "id": "all",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "objectiveDone",
            "id": "move"
          },
          {
            "t": "areaEntered",
            "side": 1,
            "x": 4,
            "z": 2,
            "radius": 8
          }
        ]
      },
      "do": [
        {
          "t": "setObjective",
          "id": "all",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "attack",
          "status": "add",
          "text": "Two Darters on the range. With your Lancers selected, tap a Darter to attack it",
          "kind": "primary"
        },
        {
          "t": "message",
          "speaker": "Command",
          "text": "Through the gap is the target range."
        }
      ]
    },
    {
      "id": "attack",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "objectiveDone",
            "id": "all"
          },
