            "t": "unitDestroyed",
            "tag": "targets"
          }
        ]
      },
      "do": [
        {
          "t": "setObjective",
          "id": "attack",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "advance",
          "status": "add",
          "text": "Tap Attack, then tap inside the far ring. Your Lancers fight anything on the way",
          "kind": "primary"
        },
        {
          "t": "message",
          "speaker": "Command",
          "text": "Targets down. A plain move drives past enemies; an Attack move fights them."
        }
      ]
    },
    {
      "id": "advance",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "objectiveDone",
            "id": "attack"
          },
          {
            "t": "areaEntered",
            "side": 1,
            "x": 46,
            "z": -40,
            "radius": 8
          }
        ]
      },
      "do": [
        {
          "t": "setObjective",
          "id": "advance",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "hold",
          "status": "add",
          "text": "Select your Lancers and tap Hold: they stay put and fire at anything in range. Beat the raid",
          "kind": "primary"
        },
        {
          "t": "message",
          "speaker": "Command",
          "text": "Well fought. Arcadian raiders are coming through the gap behind you!"
        },
        {
          "t": "spawn",
          "side": 2,
          "unitType": "unit.alien.light_skimmer",
          "count": 3,
          "x": -46,
          "z": -56,
          "tag": "raid"
        },
        {
          "t": "aiOrder",
          "tag": "raid",
          "mode": "attack",
          "x": 46,
          "z": -40
        }
      ]
    },
    {
      "id": "hold",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "objectiveDone",
            "id": "advance"
          },
          {
            "t": "unitDestroyed",
            "tag": "raid"
          }
        ]
      },
      "do": [
        {
          "t": "setObjective",
          "id": "hold",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "group",
          "status": "add",
          "text": "Tap All army, then hold tile 1 to save them as a group. Tap 1, then tap the ring",
          "kind": "primary"
        },
        {
          "t": "message",
          "speaker": "Command",
          "text": "Raid beaten. Groups let you pick a squad again with one tap."
        }
      ]
    },
    {
      "id": "group",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "objectiveDone",
            "id": "hold"
          },
          {
            "t": "areaEntered",
            "side": 1,
            "x": -14,
            "z": 6,
            "radius": 8
          }
        ]
      },
      "do": [
        {
          "t": "setObjective",
          "id": "group",
          "status": "done"
        }
      ]
    },
    {
      "id": "reinforce",
      "when": {
        "t": "and",
        "conds": [
          {
            "t": "unitsAlive",
            "side": 1,
            "op": "<=",
            "count": 1
          },
          {
            "t": "not",
            "cond": {
              "t": "objectiveDone",
              "id": "group"
            }
          }
        ]
      },
      "do": [
        {
          "t": "message",
          "speaker": "Command",
          "text": "Reinforcements are landing at your pad."
        },
        {
          "t": "spawn",
          "side": 1,
          "unitType": "unit.human.light_tank",
          "count": 3,
          "x": -30,
          "z": 26,
          "drop": true
        }
      ],
      "repeat": true
    }
