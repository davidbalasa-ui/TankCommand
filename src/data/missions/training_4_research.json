              "id": "upgrade"
            }
          },
          {
            "t": "not",
            "cond": {
              "t": "upgraded",
              "side": 1,
              "upgrade": "fireRate"
            }
          },
          {
            "t": "not",
            "cond": {
              "t": "resourceReached",
              "side": 1,
