  "triggers": [
    {
      "id": "intro",
      "when": {
        "t": "time",
        "tick": 0
      },
      "do": [
        {
          "t": "message",
          "speaker": "Command",
          "text": "Keep the tug safe and take their base apart."
        }
      ]
    },
    {
      "id": "wave",
      "when": {
        "t": "time",
        "tick": 3600
      },
      "do": [
        {
          "t": "message",
          "speaker": "Scout",
          "text": "Reinforcements inbound from the north-east!"
        },
        {
          "t": "spawn",
          "side": 2,
          "unitType": "unit.human.light_tank",
          "count": 2,
          "x": 30,
          "z": 40,
          "tag": "wave",
          "drop": true
        },
        {
          "t": "aiOrder",
          "tag": "wave",
          "mode": "attack",
          "x": -45,
          "z": -45
        }
      ]
    },
    {
      "id": "vipLost",
      "when": {
        "t": "unitDestroyed",
        "tag": "vip"
      },
      "do": [
        {
          "t": "setObjective",
          "id": "vip",
          "status": "failed"
        },
        {
          "t": "lose",
          "reason": "The supply tug was destroyed"
        }
      ]
    },
    {
      "id": "station",
      "when": {
        "t": "structureBuilt",
        "side": 1,
        "structureType": "structure.alien.metal_station"
      },
      "do": [
        {
          "t": "setObjective",
          "id": "station",
          "status": "done"
        }
      ]
    },
    {
      "id": "baseDown",
      "when": {
        "t": "allDestroyed",
        "side": 2
      },
      "do": [
        {
          "t": "setObjective",
          "id": "base",
          "status": "done"
        },
        {
          "t": "setObjective",
          "id": "vip",
          "status": "done"
        }
      ]
    }
  ],
  "timeLimitSec": 1500,
  "placeholder": true
