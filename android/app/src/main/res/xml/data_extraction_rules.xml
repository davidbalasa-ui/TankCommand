<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12 and higher (android:dataExtractionRules). Same content as
  backup_rules.xml: saves and progress (files) and settings (shared preferences), without
  local bug-report files, for cloud backup and for device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="bug-reports/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="bug-reports/" />
    </device-transfer>
</data-extraction-rules>
