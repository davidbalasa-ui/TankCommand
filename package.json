{
  "name": "tankcommand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "lint": "node scripts/lint.mjs --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "credits": "node scripts/credits.mjs",
    "credits:check": "node scripts/credits.mjs --check",
    "coverage:req": "node scripts/req-coverage.mjs",
    "cap:sync": "npm run build && cap sync android",
    "ci": "npm run lint && npm run typecheck && npm test && npm run credits:check && npm run coverage:req && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "jsdom": "^26",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
